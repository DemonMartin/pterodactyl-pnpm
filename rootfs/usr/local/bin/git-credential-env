#!/bin/sh
# Git credential helper that answers from GIT_USERNAME / GIT_TOKEN.
# Credentials are only handed to the host of GIT_REPO, never to other remotes.

[ "$1" = get ] || exit 0
[ -n "$GIT_TOKEN" ] || exit 0

host=
while IFS='=' read -r key value; do
    [ -z "$key" ] && break
    [ "$key" = host ] && host=$value
done

repo_host=$(printf '%s' "$GIT_REPO" | sed -E 's#^[A-Za-z][A-Za-z0-9+.-]*://##; s#/.*$##; s#^.*@##')
[ -n "$host" ] && [ "$host" = "$repo_host" ] || exit 0

printf 'username=%s\npassword=%s\n' "${GIT_USERNAME:-git}" "$GIT_TOKEN"
